<Project>
 <Target Name="ProtectKoshAssembly" AfterTargets="PrepareForBundle" BeforeTargets="GenerateSingleFileBundle"
         Condition="'$(ProtectCode)' == 'true'">
  <Error Condition="'$(Configuration)' != 'Release' Or '$(PublishSingleFile)' != 'true'" Text="Protection requires a Release single-file publish." />
  <PropertyGroup>
   <ProtectedAssemblyDirectory>$([System.IO.Path]::GetFullPath('$(IntermediateOutputPath)protected'))</ProtectedAssemblyDirectory>
  </PropertyGroup>
  <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildThisFileDirectory)Protect-Assembly.ps1&quot; -InputDirectory &quot;$(TargetDir).&quot; -OutputDirectory &quot;$(ProtectedAssemblyDirectory)&quot;" />
  <ItemGroup>
   <FilesToBundle Remove="@(FilesToBundle)" Condition="'%(FilesToBundle.Filename)%(FilesToBundle.Extension)' == 'KoshLauncher.dll'" />
   <FilesToBundle Include="$(ProtectedAssemblyDirectory)\KoshLauncher.dll"><RelativePath>KoshLauncher.dll</RelativePath></FilesToBundle>
  </ItemGroup>
 </Target>
</Project>
