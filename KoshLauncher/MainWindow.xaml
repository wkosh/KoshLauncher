<Window x:Class="KoshLauncher.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="KoshLauncher" Width="1180" Height="760" MinWidth="1000" MinHeight="680" WindowStyle="None"
 WindowStartupLocation="CenterScreen" Background="#09090B" Foreground="#EEE8EA" FontFamily="Segoe UI" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="34" ResizeBorderThickness="6" CornerRadius="8" GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Assets/Brand.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <Style TargetType="Button">
                <Setter Property="Foreground" Value="#FFF0F3"/>
                <Setter Property="Background" Value="#85122D"/>
                <Setter Property="BorderBrush" Value="#D42A4D"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="26,15"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Surface" CornerRadius="8" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Surface" Property="Opacity" Value="0.35"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Surface" Property="Background" Value="#AE183C"/>
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="Surface" Property="BorderBrush" Value="#FFE0E8"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Surface" Property="Background" Value="#600D22"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style TargetType="ComboBoxItem">
                <Setter Property="Foreground" Value="#F2E8EC"/>
                <Setter Property="Padding" Value="12,9"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ComboBoxItem">
                            <Border x:Name="ItemSurface" Background="Transparent" CornerRadius="5" Padding="{TemplateBinding Padding}" Margin="3,1">
                                <ContentPresenter/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsHighlighted" Value="True">
                                    <Setter TargetName="ItemSurface" Property="Background" Value="#3B1626"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="ItemSurface" Property="Background" Value="#661B35"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style TargetType="ComboBox">
                <Setter Property="Foreground" Value="#EEE8EA"/>
                <Setter Property="Background" Value="#18131B"/>
                <Setter Property="BorderBrush" Value="#382532"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="12,5"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ComboBox">
                            <Grid>
                                <ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" ClickMode="Press">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border x:Name="ComboSurface" Background="#18131B" BorderBrush="#382532" BorderThickness="1" CornerRadius="7">
                                                <Path Data="M0,0 L4,4 L8,0" Stroke="#D395A8" StrokeThickness="1.5" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,13,0"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ComboSurface" Property="BorderBrush" Value="#AC3555"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>
                                <ContentPresenter Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" IsHitTestVisible="False" VerticalAlignment="Center" Margin="12,0,32,0"/>
                                <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                                    <Border Background="#151017" BorderBrush="#643047" BorderThickness="1" CornerRadius="8" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" Margin="0,4,0,0">
                                        <ScrollViewer MaxHeight="260" CanContentScroll="True" VerticalScrollBarVisibility="Auto">
                                            <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                        </ScrollViewer>
                                    </Border>
                                </Popup>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.42"/>
                                </Trigger>
                                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                    <Setter Property="Effect">
                                        <Setter.Value>
                                            <DropShadowEffect Color="#F03460" BlurRadius="8" ShadowDepth="0" Opacity="0.35"/>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style TargetType="TextBox">
                <Setter Property="Foreground" Value="#EEE8EA"/>
                <Setter Property="Background" Value="#18131B"/>
                <Setter Property="BorderBrush" Value="#382532"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CaretBrush" Value="#FF416B"/>
                <Setter Property="SelectionBrush" Value="#962747"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TextBox">
                            <Border x:Name="Field" CornerRadius="7" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                                <ScrollViewer x:Name="PART_ContentHost"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                    <Setter TargetName="Field" Property="BorderBrush" Value="#ED4168"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.45"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style TargetType="ScrollBar">
                <Setter Property="Width" Value="8"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Track x:Name="PART_Track" IsDirectionReversed="True" Orientation="{TemplateBinding Orientation}">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="#513042" CornerRadius="4" Margin="2,0"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                            <ControlTemplate.Triggers>
                                <Trigger Property="Orientation" Value="Horizontal">
                                    <Setter Property="Width" Value="Auto"/>
                                    <Setter Property="Height" Value="8"/>
                                    <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style TargetType="CheckBox">
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="CheckBox">
                            <StackPanel Orientation="Horizontal">
                                <Border x:Name="CheckSurface" Width="16" Height="16" CornerRadius="4" BorderBrush="#6A374D" BorderThickness="1" Background="#1A121B" VerticalAlignment="Center">
                                    <Path x:Name="CheckMark" Data="M2,6 L5,9 L11,3" Stroke="#FFD6E0" StrokeThickness="1.7" Visibility="Collapsed"/>
                                </Border>
                                <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                                    <Setter TargetName="CheckSurface" Property="Background" Value="#A91F46"/>
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="CheckSurface" Property="BorderBrush" Value="#FFD6E0"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.4"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="Card" TargetType="Border">
                <Setter Property="Background" Value="#121015"/>
                <Setter Property="BorderBrush" Value="#30202A"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="14"/>
                <Setter Property="Padding" Value="20"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>
    <Grid Background="#09090B">
        <Grid.RowDefinitions>
            <RowDefinition Height="34"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Background="#100D12" BorderBrush="#2E1B25" BorderThickness="0,0,0,1">
            <Grid Margin="12,0,6,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Image Source="{StaticResource KoshMark}" Width="18" Height="18" Margin="0,0,8,0"/>
                    <TextBlock Text="KoshLauncher" FontSize="12" FontWeight="SemiBold" Foreground="#EADCE1" VerticalAlignment="Center"/>
                    <Border Background="#3A1523" CornerRadius="8" Padding="7,2" Margin="9,0,0,0">
                        <TextBlock Text="v1.0.0" FontSize="9" Foreground="#F38AA4"/>
                    </Border>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Content="—" Click="TitleMinimize_Click" Width="42" Height="28" Padding="0" Background="Transparent" BorderBrush="Transparent" FontSize="14"/>
                    <Button Content="□" Click="TitleMaximize_Click" Width="42" Height="28" Padding="0" Background="Transparent" BorderBrush="Transparent" FontSize="13"/>
                    <Button Content="×" Click="TitleClose_Click" Width="42" Height="28" Padding="0" Background="Transparent" BorderBrush="Transparent" FontSize="18"/>
                </StackPanel>
            </Grid>
        </Border>
        <Grid Grid.Row="1">
        <Grid.Triggers>
            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                <BeginStoryboard>
                    <Storyboard>
                        <!-- Uma faixa luminosa atravessa as letras da esquerda para a direita. -->
                        <DoubleAnimation Storyboard.TargetName="SweepStart" Storyboard.TargetProperty="Offset" From="-0.55" To="1.1" Duration="0:0:3.8" RepeatBehavior="Forever"/>
                        <DoubleAnimation Storyboard.TargetName="SweepCenter" Storyboard.TargetProperty="Offset" From="-0.35" To="1.3" Duration="0:0:3.8" RepeatBehavior="Forever"/>
                        <DoubleAnimation Storyboard.TargetName="SweepEnd" Storyboard.TargetProperty="Offset" From="-0.15" To="1.5" Duration="0:0:3.8" RepeatBehavior="Forever"/>
                        <DoubleAnimation Storyboard.TargetName="IconGlow" Storyboard.TargetProperty="Opacity" From="0.4" To="0.85" Duration="0:0:2.5" AutoReverse="True" RepeatBehavior="Forever"/>
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </Grid.Triggers>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="36.117"/>
            <ColumnDefinition Width="168.883"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Border Background="#0C0B0E" BorderBrush="#26161D" BorderThickness="0,0,1,0" Grid.ColumnSpan="2">
            <Grid Margin="22,32">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel>
                    <Image Source="{StaticResource KoshMark}" Width="100" Height="100" HorizontalAlignment="Left" Margin="-9,-8,0,10">
                        <Image.Effect>
                            <DropShadowEffect x:Name="IconGlow" Color="#FF123F" BlurRadius="16" ShadowDepth="0" Opacity="0.6"/>
                        </Image.Effect>
                    </Image>
                    <TextBlock Text="Kosh Launcher" x:Name="BrandText" FontFamily="./Assets/Fonts/#Pirata One" FontSize="28" TextWrapping="NoWrap">
                        <TextBlock.Foreground>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#AC1636" Offset="-1"/>
                                <GradientStop x:Name="SweepStart" Color="#BE193E" Offset="-0.55"/>
                                <GradientStop x:Name="SweepCenter" Color="#FF9BAE" Offset="-0.35"/>
                                <GradientStop x:Name="SweepEnd" Color="#ED214D" Offset="-0.15"/>
                                <GradientStop Color="#AC1636" Offset="3"/>
                            </LinearGradientBrush>
                        </TextBlock.Foreground>
                        <TextBlock.Effect>
                            <DropShadowEffect Color="#FF1748" BlurRadius="10" ShadowDepth="0" Opacity="0.65"/>
                        </TextBlock.Effect>
                    </TextBlock>
                    <Border Height="1" Background="#29171E" Margin="0,28,0,26"/>
                    <Button x:Name="HomeNav" Content="▷    Jogar" Tag="Jogar" Click="NavigateAndCloseExplore_Click" HorizontalContentAlignment="Left" Padding="15,12" Margin="0,0,0,8"/>
                    <Button x:Name="InstallNav" HorizontalContentAlignment="Left" Content="▤    Instalações" Tag="Instalações" Click="NavigateAndCloseExplore_Click" Background="#121015" BorderBrush="#292029" Padding="15,12" Margin="0,0,0,8"/>
                    <Button x:Name="ExploreNav" HorizontalContentAlignment="Left" Content="⌕    Explorar" Tag="Explorar" Click="ExploreNavigate_Click" Background="#121015" BorderBrush="#292029" Padding="15,12" Margin="0,0,0,8"/>
                    <Button x:Name="CustomizationNav" HorizontalContentAlignment="Left" Content="✦    Personalizar" Tag="Personalizar" Click="NavigateAndCloseExplore_Click" Background="#121015" BorderBrush="#292029" Padding="15,12" Margin="0,0,0,8"/>
                    <Button x:Name="SettingsNav" HorizontalContentAlignment="Left" Content="⚙    Configurações" Tag="Aparência" Click="NavigateAndCloseExplore_Click" Background="#121015" BorderBrush="#292029" Padding="15,12"/>
                </StackPanel>
                <StackPanel Grid.Row="2">
                    <TextBlock FontSize="11" Foreground="#BCA0AA"><Run Language="pt-br" Text="@wkosh07"/></TextBlock>
                    <TextBlock Text="v1.0.0" FontSize="10" Foreground="#87747D" Margin="0,12,0,0"/>
                </StackPanel>
            </Grid>
        </Border>
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="74"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Border BorderBrush="#241B23" BorderThickness="0,0,0,1" Padding="30,0">
                <Grid>
                    <TextBlock x:Name="PageTitle" Text="Jogar" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <Button x:Name="AccountButton" Content="Entrar com Microsoft" Click="ConnectAccount_Click" HorizontalAlignment="Right" VerticalAlignment="Center" Background="#141116" BorderBrush="#35242E" Padding="16,10"/>
                </Grid>
            </Border>
            <Grid Grid.Row="1" Margin="30,24">
                <Grid x:Name="HomePanel">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Border BorderBrush="#38202B" BorderThickness="1" CornerRadius="16" Padding="32" Margin="0,0,0,20">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#1C1019" Offset="0"/>
                                <GradientStop Color="#0E0D11" Offset="0.65"/>
                                <GradientStop Color="#26101B" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="MINECRAFT: JAVA EDITION" Foreground="#C9899B" FontSize="10" FontWeight="SemiBold"/>
                            <Grid Grid.Row="1" VerticalAlignment="Center" Margin="0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="180"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Minecraft" FontSize="42" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="SelectedVersionText" Text="Escolha uma versão" FontSize="17" Foreground="#B598A5" Margin="0,8,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                                <Image Grid.Column="1" Source="{StaticResource KoshMark}" Width="160" Height="160" Margin="12,0,0,0" Opacity="0.85"/>
                            </Grid>
                            <StackPanel Grid.Row="2" Orientation="Horizontal">
                                <Border Background="#22121B" CornerRadius="4" Padding="10,6">
                                    <TextBlock Text="Java Edition" FontSize="10" Foreground="#D1A7B5"/>
                                </Border>
                                <Border Background="#19151B" CornerRadius="4" Padding="10,6" Margin="8,0,0,0">
                                    <TextBlock x:Name="InstallationBadge" Text="Aguardando seleção" FontSize="10" Foreground="#AF99A6"/>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Border Grid.Row="1" Background="#110F14" BorderBrush="#28202B" BorderThickness="1" CornerRadius="8" Padding="20">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Suas instalações" FontSize="14"/>
                                <TextBlock x:Name="InstallSummary" Text="Consultando instalações..." Foreground="#A992A0" FontSize="12" Margin="0,7,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                            <Button Grid.Column="1" Content="Ver instalações  →" Tag="Instalações" Click="NavigateAndCloseExplore_Click" Background="#19131B" BorderBrush="#3D2935" Padding="16,10" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                </Grid>
                <Grid x:Name="InstallPanel" Visibility="Collapsed" MaxWidth="1440" HorizontalAlignment="Center">
                    <Border Background="#110F14" BorderBrush="#30222D" BorderThickness="1" CornerRadius="10" Padding="22">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <StackPanel>
                                <WrapPanel Margin="0,0,0,10">
                                    <Button x:Name="InstallFabricButton" Content="＋ Fabric" Click="ChooseFabric_Click" Padding="14,10" Margin="0,0,8,8"/>
                                    <Button x:Name="InstallForgeButton" Content="＋ Forge" Click="InstalarForge_Click" Padding="14,10" Margin="0,0,8,8" Background="#6A3B20" BorderBrush="#B66D35"/>
                                    <Button x:Name="InstallNeoForgeButton" Content="＋ NeoForge" Click="InstalarNeoForge_Click" Padding="14,10" Margin="0,0,8,8" Background="#244631" BorderBrush="#4F9B68"/>
                                    <Button x:Name="InstallQuiltButton" Content="＋ Quilt" Click="InstalarQuilt_Click" Padding="14,10" Margin="0,0,8,8" Background="#364262" BorderBrush="#7387C2"/>
                                    <Button Content="Pasta de mods" Click="AbrirMods_Click" Padding="14,10" Margin="0,0,8,8" Background="#19131B"/>
                                    <Button Content="Pasta do perfil" Click="AbrirInstancia_Click" Padding="14,10" Margin="0,0,8,8" Background="#19131B"/>
                                    <Button Content="Logs" Click="AbrirLogs_Click" Padding="14,10" Margin="0,0,8,8" Background="#19131B"/>
                                    <Button x:Name="ImportModsButton" Content="Importar mods" Click="ImportarMods_Click" Padding="14,10" Margin="0,0,8,8" Background="#19131B"/>
                                    <Button x:Name="BackupButton" Content="Backup dos mundos" Click="Backup_Click" Padding="14,10" Margin="0,0,8,8" Background="#19131B"/>
                                    <Button Content="Atualizar" Click="AtualizarLista_Click" Padding="14,10" Margin="0,0,8,8" Background="#19131B"/>
                                </WrapPanel>
                                <TextBlock Text="Perfis locais" FontSize="18" Margin="0,0,0,12"/>
                            </StackPanel>
                            <ListBox Grid.Row="1" x:Name="InstalledVersionsList" SelectionChanged="InstalacaoSelecionada" Background="Transparent" Foreground="#EEE8EA" BorderThickness="0" FontSize="14" ScrollViewer.HorizontalScrollBarVisibility="Auto">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Padding" Value="14"/>
                                        <Setter Property="Margin" Value="0,0,0,7"/>
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border x:Name="ProfileSurface" Padding="{TemplateBinding Padding}" Background="#19131B" BorderBrush="#30212B" BorderThickness="1" CornerRadius="8">
                                                        <ContentPresenter/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="ProfileSurface" Property="BorderBrush" Value="#A73355"/>
                                                        </Trigger>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter TargetName="ProfileSurface" Property="Background" Value="#3A1324"/>
                                                            <Setter TargetName="ProfileSurface" Property="BorderBrush" Value="#E33862"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                            </ListBox>
                            <TextBlock Grid.Row="2" x:Name="InstallStatus" Foreground="#B29AA8" Margin="0,12,0,0" TextWrapping="Wrap"/>
                        </Grid>
                    </Border>
                </Grid>
                <Grid x:Name="CustomizationPanel" Visibility="Collapsed">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="0,0,8,0">
                            <TextBlock Text="Gráficos e personagem" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,16"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource Card}" VerticalAlignment="Top">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,10">
                                            <TextBlock Text="◈" FontSize="28" Foreground="#FF416C"/>
                                            <Border Background="#2B1420" CornerRadius="5" Padding="8,5" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                <TextBlock Text="GRÁFICOS" Foreground="#EE8FA8" FontSize="9" FontWeight="SemiBold"/>
                                            </Border>
                                        </Grid>
                                        <TextBlock Text="OptiFine" FontSize="25" FontWeight="SemiBold"/>
                                        <TextBlock Text="Mais opções de vídeo e suporte a shaders, em uma instalação própria." Foreground="#B49CAA" TextWrapping="Wrap" LineHeight="20" Margin="0,8,0,22"/>
                                        <TextBlock Text="VERSÃO DO MINECRAFT / EDIÇÃO" FontSize="9" Foreground="#AA8295" Margin="0,0,0,8"/>
                                        <ComboBox x:Name="OptifineVersionCombo" Height="40" ToolTip="Clique em Atualizar lista para consultar as edições oficiais."/>
                                        <CheckBox x:Name="OptifinePreviewToggle" Content="Mostrar versões de prévia" Foreground="#BDA5B1" FontSize="11" Margin="0,12,0,16" Click="FilterOptifine_Click"/>
                                        <Button x:Name="OptifineInstallButton" Content="↓   Instalar OptiFine" Click="OptifineInstall_Click" Padding="12,13" IsEnabled="False"/>
                                        <WrapPanel Margin="0,10,0,0">
                                            <Button x:Name="RefreshOptifineButton" Content="↻  Atualizar lista" Click="RefreshOptifine_Click" Background="#1D161F" BorderBrush="#3A2632" Padding="10,9" Margin="0,0,8,8" FontSize="11"/>
                                            <Button x:Name="ImportOptifineButton" Content="Importar .jar" Click="ImportOptifine_Click" Background="#1D161F" BorderBrush="#3A2632" Padding="10,9" FontSize="11" Margin="0,0,0,8"/>
                                        </WrapPanel>
                                        <TextBlock x:Name="OptifineStatus" Text="Atualize a lista ou importe um arquivo do site oficial. A versão é identificada automaticamente." Foreground="#E1A0B3" TextWrapping="Wrap" LineHeight="19" FontSize="12" Margin="0,8,0,14"/>
                                        <Border Height="1" Background="#30202A" Margin="0,0,0,14"/>
                                        <TextBlock Text="Perfil separado do Fabric. Seus mundos atuais ficam nas instalações de origem." Foreground="#99808E" TextWrapping="Wrap" FontSize="11" LineHeight="17"/>
                                        <Button Content="Site oficial  ↗" Click="OptifineSite_Click" Background="Transparent" BorderThickness="0" HorizontalAlignment="Left" Padding="0,12,8,0" Foreground="#DF829D" FontSize="11"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="2" Style="{StaticResource Card}" VerticalAlignment="Top">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,10">
                                            <TextBlock Text="✧" FontSize="28" Foreground="#FF416C"/>
                                            <Border Background="#2B1420" CornerRadius="5" Padding="8,5" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                <TextBlock Text="PERSONAGEM" Foreground="#EE8FA8" FontSize="9" FontWeight="SemiBold"/>
                                            </Border>
                                        </Grid>
                                        <TextBlock Text="Sua skin" FontSize="25" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="SkinAccountStatus" Text="Entre com Microsoft para aplicar sua skin." Foreground="#B49CAA" TextWrapping="Wrap" LineHeight="20" Margin="0,8,0,18"/>
                                        <Border Background="#0D0B10" CornerRadius="10" BorderBrush="#35202C" BorderThickness="1" Padding="8" Height="84">
                                            <Grid>
                                                <TextBlock Text="✦" Foreground="#522438" FontSize="36" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                <Image x:Name="SkinPreview" Width="64" Height="64" Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor" Visibility="Collapsed"/>
                                            </Grid>
                                        </Border>
                                        <TextBlock x:Name="SkinFileText" Text="PNG 64 × 64 ou 64 × 32. Prévia do rosto." Foreground="#99808E" FontSize="11" TextWrapping="Wrap" Margin="0,10,0,14"/>
                                        <ComboBox x:Name="SkinModelCombo" Height="40" SelectedIndex="0" Margin="0,0,0,10">
                                            <ComboBoxItem Content="Clássico (Steve)" Tag="classic"/>
                                            <ComboBoxItem Content="Braços finos (Alex)" Tag="slim"/>
                                        </ComboBox>
                                        <Button x:Name="ChooseSkinButton" Content="＋  Escolher imagem" Click="ChooseSkin_Click" Background="#1D161F" BorderBrush="#3A2632" Padding="12,11" Margin="0,0,0,10"/>
                                        <Button x:Name="ApplySkinButton" Content="Aplicar à minha conta" Click="ApplySkin_Click" IsEnabled="False" Padding="12,13"/>
                                        <Button x:Name="ApplyOfflineSkinButton" Content="Usar no perfil offline" Click="ApplyOfflineSkin_Click" Background="#1D161F" BorderBrush="#743047" Padding="12,13" Margin="0,10,0,0"/>
                                        <TextBlock x:Name="SkinStatus" Foreground="#E1A0B3" TextWrapping="Wrap" FontSize="12" Margin="0,12,0,0"/>
                                        <TextBlock Text="Offline: instala o CustomSkinLoader no perfil Fabric selecionado. A skin local é visível apenas para você." Foreground="#99808E" FontSize="11" TextWrapping="Wrap" LineHeight="17" Margin="0,12,0,0"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
                <Grid x:Name="ExplorePanel" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,0,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="125"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="CurseForgeSearchBox" Height="40" Padding="12,5" Margin="0,0,10,0" KeyDown="CurseForgeSearch_KeyDown" ToolTip="Nome do mod, modpack, shader..."/>
                            <ComboBox Grid.Column="1" x:Name="CurseForgeTypeCombo" Height="40" SelectedIndex="0" Margin="0,0,10,0">
                                <ComboBoxItem Content="Mods" Tag="6"/>
                                <ComboBoxItem Content="Modpacks" Tag="4471"/>
                                <ComboBoxItem Content="Shaders" Tag="6552"/>
                                <ComboBoxItem Content="Resource packs" Tag="12"/>
                                <ComboBoxItem Content="Mundos" Tag="17"/>
                            </ComboBox>
                            <ComboBox Grid.Column="2" x:Name="CurseForgeVersionBox" Height="40" Margin="0,0,10,0" ToolTip="Versão do Minecraft"/>
                            <Button Grid.Column="3" x:Name="CurseForgeSearchButton" Content="Pesquisar" Click="CurseForgeSearch_Click" Padding="18,10"/>
                        </Grid>
                    </Border>
                    <ListBox Grid.Row="1" x:Name="CurseForgeResultsList" Background="Transparent" Foreground="#EEE8EA" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <ContentPresenter HorizontalAlignment="Stretch"/>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#121015" BorderBrush="#30202A" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,6,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="76"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="64" Height="64" CornerRadius="9" Background="#251520" VerticalAlignment="Top">
                                            <Image Source="{Binding LogoUrl}" Stretch="UniformToFill"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="12,0,16,0">
                                            <TextBlock Text="{Binding Name}" Foreground="#F4E9EE" FontSize="17" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding Summary}" Foreground="#C7AEB9" TextWrapping="Wrap" MaxHeight="42" Margin="0,6,0,7"/>
                                            <TextBlock Text="{Binding Details}" Foreground="#8F7985" FontSize="11"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                            <Button Content="Baixar" Click="InstallCurseForge_Click" Tag="{Binding}" Padding="16,9"/>
                                            <Button Content="Página  ↗" Click="OpenCurseForgePage_Click" Tag="{Binding}" Background="Transparent" BorderThickness="0" Foreground="#D98AA0" Padding="8,7"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <Border Grid.Row="2" Background="#110F14" BorderBrush="#30202A" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,10,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock x:Name="CurseForgeStatus" Text="Não exige conta Microsoft. Selecione um perfil local e pesquise o catálogo." Foreground="#BCA0AE" TextWrapping="Wrap" VerticalAlignment="Center"/>
                            <Border Grid.Column="1" Background="#251520" CornerRadius="5" Padding="10,6" Margin="14,0,0,0">
                                <TextBlock Text="CURSEFORGE" Foreground="#E993AB" FontSize="10" FontWeight="SemiBold"/>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
                <Grid x:Name="SettingsPanel" Visibility="Collapsed">
                    <Border Background="#110F14" BorderBrush="#30222D" BorderThickness="1" CornerRadius="10" Padding="24">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="0,0,14,0">
                                <TextBlock Text="Configurações" FontSize="22"/>
                                <TextBlock Text="Aparência" Foreground="#CFA9B8" FontSize="16" Margin="0,20,0,12"/>
                                <CheckBox x:Name="NeonToggle" Content="Animar o neon da marca" Foreground="#E4CED8" IsChecked="True" Checked="NeonToggle_Changed" Unchecked="NeonToggle_Changed" FontSize="14"/>
                                <TextBlock Text="Memória do Minecraft" FontSize="16" Margin="0,24,0,10"/>
                                <TextBlock Text="{Binding ElementName=RamSlider, Path=Value, StringFormat={}{0:0} GB}" Foreground="#EF6987" FontSize="20" Margin="0,0,0,10"/>
                                <Slider x:Name="RamSlider" Minimum="1" Maximum="8" Value="2" TickFrequency="1" IsSnapToTickEnabled="True" AutoToolTipPlacement="BottomRight" AutoToolTipPrecision="0"/>
                                <TextBlock Text="Reserve memória para o Windows e outros programas." Foreground="#B69BA9" TextWrapping="Wrap" Margin="0,10,0,18"/>
                                <TextBlock Text="Resolução da janela" FontSize="16" Margin="0,0,0,10"/>
                                <ComboBox x:Name="ResolutionComboBox" SelectedIndex="0" Height="32" Margin="0,0,0,16">
                                    <ComboBoxItem Content="1280 × 720" Tag="1280x720"/>
                                    <ComboBoxItem Content="1600 × 900" Tag="1600x900"/>
                                    <ComboBoxItem Content="1920 × 1080" Tag="1920x1080"/>
                                </ComboBox>
                                <CheckBox x:Name="FullscreenCheckBox" Content="Iniciar em tela cheia" Foreground="#E4CED8" FontSize="14" Margin="0,0,0,20"/>
                                <TextBlock Text="Versões na lista" FontSize="16" Margin="0,0,0,10"/>
                                <ComboBox x:Name="VersionFilterComboBox" SelectedIndex="0" Height="32" Margin="0,0,0,20">
                                    <ComboBoxItem Content="Estáveis e locais"/>
                                    <ComboBoxItem Content="Somente locais"/>
                                    <ComboBoxItem Content="Todas, incluindo snapshots"/>
                                </ComboBox>
                                <WrapPanel>
                                    <Button Content="Salvar configurações" Click="SalvarPreferencias_Click" Padding="18,12" Margin="0,0,12,10"/>
                                    <Button x:Name="LogoutButton" Content="Usar sessão local" Click="Logout_Click" Padding="18,12" Margin="0,0,0,10" Background="#19131B"/>
                                </WrapPanel>
                                <TextBlock x:Name="PreferencesStatus" Foreground="#C9A8B6" TextWrapping="Wrap" Margin="0,8,0,0"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Grid>
            <Border Grid.Row="2" Background="#100C12" BorderBrush="#442030" BorderThickness="0,1,0,0" Padding="30,18">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="200"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="145"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="JOGADOR" Foreground="#AC879A" FontSize="9" Margin="0,0,0,8"/>
                                <TextBox x:Name="NicknameTextBox" Text="KoshPlayer" MaxLength="16" Height="40" Padding="10,4"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="INSTALAÇÃO" Foreground="#AC879A" FontSize="9" Margin="0,0,0,8"/>
                                <ComboBox x:Name="VersionComboBox" Height="40" MaxDropDownHeight="260" IsEnabled="False" ToolTip="Versão do Minecraft" DropDownOpened="VersionComboBox_DropDownOpened" SelectionChanged="VersionComboBox_FilterUnsupported"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock x:Name="AccountStatus" Text="Sessão local • Escolha uma versão." Foreground="#AE92A1" FontSize="11" Margin="0,7,0,0" TextWrapping="Wrap"/>
                        <StackPanel x:Name="DownloadPanel" Visibility="Collapsed" Margin="0,10,0,0">
                            <ProgressBar x:Name="DownloadProgress" Height="6" Minimum="0" Maximum="100"
                                         Foreground="#ED214D" Background="#28121C" BorderThickness="0"/>
                            <TextBlock x:Name="DownloadDetails" Foreground="#BCA0AE" FontSize="11"
                                       Margin="0,6,0,0" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <Button x:Name="PlayButton"
        Grid.Column="1"
        Content="JOGAR   ▷" FontSize="15"
        Click="Jogar_Click"
        VerticalAlignment="Center"
        Padding="16,20"/>
                        <Button x:Name="CancelButton" Content="Cancelar preparação" Click="Cancelar_Click" Visibility="Collapsed" Padding="10,10" Margin="0,10,0,0" Background="#211019"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
        </Grid>
    </Grid>
</Window>




