<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Assets\KoshLauncher.ico</ApplicationIcon>
    <Version>0.4.2</Version>
    <Product>KoshLauncher</Product>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CmlLib.Core" Version="4.0.6" />
    <PackageReference Include="CmlLib.Core.Auth.Microsoft" Version="3.3.1" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\Fonts\PirataOne-Regular.ttf" />
    <EmbeddedResource Include="Helpers\KoshOptifineBridge.class" />
  </ItemGroup>
  <Import Project="..\build\Protection.targets" />
</Project>

